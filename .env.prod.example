MYSQL_DATABASE=houkago
MYSQL_USER=houkago
MYSQL_PASSWORD=<change-me>
MYSQL_ROOT_PASSWORD=<change-me>
SPRING_PROFILES_ACTIVE=docker
HOUKAGO_RESYNC_ENABLED=false
HOUKAGO_RESYNC_POSTS_ROOT=/workspace/houkago.posts
HOUKAGO_RESYNC_COMMIT_HASH=<posts-commit-hash>
HOUKAGO_PUBLIC_ASSET_ORIGIN=https://api.example.test
HOUKAGO_PUBLIC_ASSET_ROOT=/workspace/public-assets
HOUKAGO_ASSET_PUBLICATION_GENERATION_ID=<posts-commit-hash>
HOUKAGO_POSTS_WEBHOOK_ENABLED=false
HOUKAGO_POSTS_WEBHOOK_SECRET=
HOUKAGO_POSTS_WEBHOOK_REPOSITORY_FULL_NAME=<owner>/houkago.posts
HOUKAGO_POSTS_WEBHOOK_REF=refs/heads/main
HOUKAGO_POSTS_WEBHOOK_SPOOL_ROOT=/workspace/sync-jobs
HOUKAGO_DEPLOY_WEBHOOK_ENABLED=false
HOUKAGO_DEPLOY_WEBHOOK_SECRET=
HOUKAGO_DEPLOY_IMAGE_REPOSITORY=ghcr.io/hokago-memories/houkago.server
HOUKAGO_DEPLOY_SPOOL_ROOT=/workspace/deploy-jobs
HOUKAGO_DEPLOY_WORKER_GRACE_PERIOD=5s
HOUKAGO_DEPLOY_GID=2002
HOUKAGO_OPS_WEBHOOK_ENABLED=false
HOUKAGO_OPS_WEBHOOK_SECRET=
HOUKAGO_OPS_SPOOL_ROOT=/workspace/deploy-jobs/ops
HOUKAGO_OPS_WORKER_GRACE_PERIOD=5s
APP_HOST_PORT=8080

#!/usr/bin/env bash

set -uo pipefail

readonly WORKER_ENV_FILE="${HOUKAGO_WORKER_ENV_FILE:-/opt/houkago/env/content-sync-worker.env}"
if [[ -r "$WORKER_ENV_FILE" ]]; then
	set -a
	# shellcheck disable=SC1090
	source "$WORKER_ENV_FILE"
	set +a
fi

readonly SPOOL_ROOT="${HOUKAGO_SYNC_SPOOL_ROOT:-/opt/houkago/sync-jobs}"
readonly INCOMING_DIRECTORY="${SPOOL_ROOT}/incoming"
readonly PROCESSING_DIRECTORY="${SPOOL_ROOT}/processing"
readonly SUCCEEDED_DIRECTORY="${SPOOL_ROOT}/succeeded"
readonly FAILED_DIRECTORY="${SPOOL_ROOT}/failed"
readonly TEMPORARY_DIRECTORY="${SPOOL_ROOT}/.tmp"
readonly LOCK_FILE="${SPOOL_ROOT}/worker.lock"
readonly POSTS_ROOT="${HOUKAGO_POSTS_ROOT:-/opt/houkago/posts}"
readonly SERVER_ROOT="${HOUKAGO_SERVER_ROOT:-/opt/houkago/server}"
readonly SERVER_ENV="${HOUKAGO_SERVER_ENV:-/opt/houkago/env/server.env}"
readonly RELEASE_ENV="${HOUKAGO_RELEASE_ENV:-/opt/houkago/env/backend-release.env}"
readonly COMPOSE_FILE="${HOUKAGO_COMPOSE_FILE:-/opt/houkago/runtime/compose.prod.yml}"
readonly COMPOSE_PROJECT_NAME="${HOUKAGO_COMPOSE_PROJECT_NAME:-server}"
readonly MAINTENANCE_LOCK_FILE="${HOUKAGO_MAINTENANCE_LOCK_FILE:-/opt/houkago/locks/backend-maintenance.lock}"
readonly MAINTENANCE_LOCK_TIMEOUT_SECONDS="${HOUKAGO_MAINTENANCE_LOCK_TIMEOUT_SECONDS:-60}"
readonly PUBLIC_API_BASE_URL="${HOUKAGO_PUBLIC_API_BASE_URL:-https://api.houkago.moe}"
readonly PUBLIC_DETAIL_SLUG="${HOUKAGO_PUBLIC_DETAIL_SLUG:-boj-2342}"
readonly PUBLIC_ASSET_ROOT="${HOUKAGO_PUBLIC_ASSET_ROOT:-/opt/houkago/assets}"
readonly PUBLIC_ASSET_BASE_URL_RAW="${HOUKAGO_PUBLIC_ASSET_BASE_URL:-$PUBLIC_API_BASE_URL}"
readonly PUBLIC_ASSET_BASE_URL="${PUBLIC_ASSET_BASE_URL_RAW%/}"
readonly REVALIDATE_URL="${HOUKAGO_REVALIDATE_URL:-}"
readonly REVALIDATE_SECRET="${HOUKAGO_REVALIDATE_SECRET:-}"
readonly REVALIDATION_MAX_ATTEMPTS=3
readonly REVALIDATION_CONNECT_TIMEOUT_SECONDS=5
readonly REVALIDATION_MAX_TIME_SECONDS=15

failures=0
current_processing_path=""
cleanup_started=false
ASSET_PUBLIC_POST_COUNT=""
ASSET_COUNT=""
ASSET_TOTAL_BYTES=""
ASSET_SMOKE_PATH=""

log() {
	printf 'event=houkago_content_sync_worker %s\n' "$*"
}

run_compose() {
	env -u HOUKAGO_SERVER_IMAGE docker compose \
		--project-name "$COMPOSE_PROJECT_NAME" \
		--env-file "$SERVER_ENV" \
		--env-file "$RELEASE_ENV" \
		-f "$COMPOSE_FILE" \
		"$@"
}

run_checkout_git() {
	(
		umask 0022
		git -C "$POSTS_ROOT" "$@"
	)
}

move_without_overwrite() {
	local source_path="$1"
	local target_path="$2"

	if [[ -e "$target_path" ]]; then
		return 1
	fi
	mv -- "$source_path" "$target_path"
}

mark_failed() {
	local source_path="$1"
	local reason="$2"
	local base_name target_path timestamp

	base_name="$(basename -- "$source_path")"
	target_path="${FAILED_DIRECTORY}/${base_name}"
	if [[ -e "$target_path" ]]; then
		timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
		target_path="${FAILED_DIRECTORY}/${base_name%.json}.duplicate-${timestamp}-$$.json"
	fi

	if [[ -e "$source_path" ]] && ! move_without_overwrite "$source_path" "$target_path"; then
		log "status=FAILED reason=failed_state_move job=${base_name}"
		return 1
	fi
	if [[ "$current_processing_path" == "$source_path" ]]; then
		current_processing_path=""
	fi
	log "status=FAILED reason=${reason} job=${base_name}"
	return 0
}

archive_recovery_collision() {
	local processing_path="$1"
	local collision_state="$2"
	local base_name timestamp target_path

	base_name="$(basename -- "$processing_path")"
	timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
	target_path="${FAILED_DIRECTORY}/${base_name%.json}.recovery-collision-${timestamp}-$$.json"
	if ! move_without_overwrite "$processing_path" "$target_path"; then
		log "phase=orphan_recovery status=FAILED reason=collision_archive_failed collisionState=${collision_state} job=${base_name}"
		return 1
	fi
	if [[ "$current_processing_path" == "$processing_path" ]]; then
		current_processing_path=""
	fi
	log "phase=orphan_recovery status=FAILED reason=duplicate_state collisionState=${collision_state} job=${base_name}"
	return 0
}

recover_processing_job() {
	local processing_path="$1"
	local trigger="$2"
	local validation_output delivery_id base_name incoming_path state_directory state

	base_name="$(basename -- "$processing_path")"
	if [[ ! -f "$processing_path" || -L "$processing_path" ]]; then
		mark_failed "$processing_path" "orphan_invalid_job_file" || true
		return 1
	fi
	if ! validation_output="$(validate_job "$processing_path" 2>/dev/null)"; then
		mark_failed "$processing_path" "orphan_invalid_job" || true
		return 1
	fi
	delivery_id="$(printf '%s\n' "$validation_output" | sed -n '1p')"

	for state in succeeded failed incoming; do
		case "$state" in
			succeeded) state_directory="$SUCCEEDED_DIRECTORY" ;;
			failed) state_directory="$FAILED_DIRECTORY" ;;
			incoming) state_directory="$INCOMING_DIRECTORY" ;;
		esac
		if [[ -e "${state_directory}/${base_name}" ]]; then
			archive_recovery_collision "$processing_path" "$state" || true
			return 1
		fi
	done

	incoming_path="${INCOMING_DIRECTORY}/${base_name}"
	if ! move_without_overwrite "$processing_path" "$incoming_path"; then
		mark_failed "$processing_path" "orphan_requeue_failed" || true
		return 1
	fi
	if [[ "$current_processing_path" == "$processing_path" ]]; then
		current_processing_path=""
	fi
	log "phase=orphan_recovery status=REQUEUED trigger=${trigger} deliveryId=${delivery_id} job=${base_name}"
	return 0
}

recover_orphaned_jobs() {
	local orphan_path

	shopt -s nullglob
	set -- "${PROCESSING_DIRECTORY}"/*.json
	shopt -u nullglob
	for orphan_path in "$@"; do
		if ! recover_processing_job "$orphan_path" "startup"; then
			failures=$((failures + 1))
		fi
	done
}

cleanup() {
	local original_exit_code=$?

	if [[ "$cleanup_started" == "true" ]]; then
		return "$original_exit_code"
	fi
	cleanup_started=true
	if [[ -n "$current_processing_path" && -e "$current_processing_path" ]]; then
		recover_processing_job "$current_processing_path" "signal_cleanup" || true
	fi
	return "$original_exit_code"
}

validate_job() {
	local job_path="$1"

	python3 - "$job_path" <<'PY'
import datetime
import json
import pathlib
import re
import sys
import uuid

path = pathlib.Path(sys.argv[1])
try:
    with path.open("r", encoding="utf-8") as file:
        job = json.load(file)
except (OSError, UnicodeError, json.JSONDecodeError):
    raise SystemExit(1)

if not isinstance(job, dict) or set(job) != {"deliveryId", "commitSha", "receivedAt"}:
    raise SystemExit(1)

delivery_id = job.get("deliveryId")
commit_sha = job.get("commitSha")
received_at = job.get("receivedAt")
if not all(isinstance(value, str) for value in (delivery_id, commit_sha, received_at)):
    raise SystemExit(1)

try:
    normalized_delivery_id = str(uuid.UUID(delivery_id))
except ValueError:
    raise SystemExit(1)
if normalized_delivery_id != delivery_id or path.name != f"{delivery_id}.json":
    raise SystemExit(1)

if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", commit_sha) or set(commit_sha) == {"0"}:
    raise SystemExit(1)

try:
    if not received_at.endswith("Z"):
        raise ValueError
    datetime.datetime.fromisoformat(received_at[:-1] + "+00:00")
except ValueError:
    raise SystemExit(1)

print(delivery_id)
print(commit_sha)
PY
}

verify_checkout_readable() {
	(
		cd "$SERVER_ROOT" || exit 1
		run_compose \
			--profile asset-sync \
			run --rm --no-deps -T --entrypoint /bin/sh asset-sync -eu -c '
				root="${HOUKAGO_ASSET_PUBLICATION_POSTS_ROOT:?}"
				if [ ! -d "$root" ] || [ ! -x "$root" ]; then
					printf "HOUKAGO_UNREADABLE_PATH=.\n"
					exit 1
				fi

				unreadable_path="$(find "$root" \
					-type d \( \
						-name ".*" -o \
						-name node_modules -o \
						-name dist -o \
						-name build -o \
						-name assets \
					\) -prune -o \
					-type f -name index.md ! -readable -print -quit)" || {
					printf "HOUKAGO_UNREADABLE_PATH=.\n"
					exit 1
				}
				if [ -n "$unreadable_path" ]; then
					case "$unreadable_path" in
						"$root"/*) unreadable_path="${unreadable_path#"$root"/}" ;;
					esac
					printf "HOUKAGO_UNREADABLE_PATH=%s\n" "$unreadable_path"
					exit 1
				fi
			'
	)
}

verify_public_api() {
	local health_response list_status featured_status detail_status

	health_response="$(curl -fsS --max-time 10 http://127.0.0.1:8080/actuator/health 2>/dev/null)" || return 1
	printf '%s' "$health_response" | grep -q '"status":"UP"' || return 1

	list_status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 15 \
		"${PUBLIC_API_BASE_URL}/api/posts?page=0&size=1")" || return 1
	featured_status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 15 \
		"${PUBLIC_API_BASE_URL}/api/posts?featured=true&page=0&size=1")" || return 1
	detail_status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 15 \
		"${PUBLIC_API_BASE_URL}/api/posts/${PUBLIC_DETAIL_SLUG}")" || return 1

	[[ "$list_status" == "200" && "$featured_status" == "200" && "$detail_status" == "200" ]]
}

perform_frontend_revalidation_request() {
	printf 'Authorization: Bearer %s\n' "$REVALIDATE_SECRET" | curl \
		--silent \
		--show-error \
		--output /dev/null \
		--write-out '%{http_code}' \
		--proto '=https' \
		--connect-timeout "$REVALIDATION_CONNECT_TIMEOUT_SECONDS" \
		--max-time "$REVALIDATION_MAX_TIME_SECONDS" \
		--request POST \
		--header @- \
		"$REVALIDATE_URL"
}

revalidation_backoff() {
	sleep "$1"
}

revalidate_frontend() {
	local attempt http_status curl_status reason

	if [[ -z "$REVALIDATE_URL" || -z "$REVALIDATE_SECRET" ]]; then
		log "phase=frontend_revalidation status=WARNING attempts=0 reason=configuration_missing"
		return 1
	fi
	if [[ "$REVALIDATE_URL" != https://* ]]; then
		log "phase=frontend_revalidation status=WARNING attempts=0 reason=invalid_https_url"
		return 1
	fi

	for ((attempt = 1; attempt <= REVALIDATION_MAX_ATTEMPTS; attempt++)); do
		http_status="$(perform_frontend_revalidation_request 2>/dev/null)"
		curl_status=$?

		if [[ "$curl_status" -eq 0 && "$http_status" == "200" ]]; then
			log "phase=frontend_revalidation status=SUCCESS attempts=${attempt} httpStatus=200"
			return 0
		fi

		if [[ "$curl_status" -ne 0 ]]; then
			reason="network_or_timeout"
		elif [[ "$http_status" == "401" || "$http_status" == "403" ]]; then
			log "phase=frontend_revalidation status=WARNING attempts=${attempt} reason=authentication_rejected httpStatus=${http_status}"
			return 1
		elif [[ "$http_status" == "429" ]]; then
			reason="http_429"
		elif [[ "$http_status" =~ ^5[0-9]{2}$ ]]; then
			reason="http_5xx"
		else
			log "phase=frontend_revalidation status=WARNING attempts=${attempt} reason=unexpected_http_status httpStatus=${http_status:-none}"
			return 1
		fi

		if [[ "$attempt" -eq "$REVALIDATION_MAX_ATTEMPTS" ]]; then
			log "phase=frontend_revalidation status=WARNING attempts=${attempt} reason=${reason} httpStatus=${http_status:-none} curlExit=${curl_status}"
			return 1
		fi

		log "phase=frontend_revalidation status=RETRY attempt=${attempt} reason=${reason} httpStatus=${http_status:-none} curlExit=${curl_status}"
		revalidation_backoff "$attempt"
	done

	return 1
}

run_one_shot_sync() {
	local delivery_id="$1"
	local checkout_head="$2"
	local sync_log sync_status

	sync_log="$(mktemp "${TEMPORARY_DIRECTORY}/sync-${delivery_id}.XXXXXX.log")" || return 1
	log "phase=db_sync status=STARTED service=sync deliveryId=${delivery_id} commitSha=${checkout_head}"
	(
		cd "$SERVER_ROOT" || exit 1
		HOUKAGO_RESYNC_COMMIT_HASH="$checkout_head" run_compose \
			--profile sync \
			run --rm sync
	) 2>&1 | tee "$sync_log"
	sync_status=${PIPESTATUS[0]}

	if [[ "$sync_status" -ne 0 ]] \
			|| ! grep -Fq "status=SUCCESS commitHash=${checkout_head}" "$sync_log" \
			|| ! grep -Eq 'CREATED=[0-9]+ UPDATED=[0-9]+ TOUCHED=[0-9]+ DELETED=[0-9]+' "$sync_log"; then
		rm -f -- "$sync_log"
		return 1
	fi

	rm -f -- "$sync_log"
	log "phase=db_sync status=SUCCESS service=sync deliveryId=${delivery_id} commitSha=${checkout_head}"
	return 0
}

extract_log_field() {
	local line="$1"
	local field="$2"
	printf '%s\n' "$line" | sed -n "s/.* ${field}=\([^ ]*\).*/\1/p"
}

run_asset_stage() {
	local delivery_id="$1"
	local checkout_head="$2"
	local asset_log stage_status success_line

	asset_log="$(mktemp "${TEMPORARY_DIRECTORY}/asset-stage-${delivery_id}.XXXXXX.log")" || return 1
	log "phase=asset_stage status=STARTED service=asset-sync deliveryId=${delivery_id} commitSha=${checkout_head} generation=${checkout_head}"
	(
		cd "$SERVER_ROOT" || exit 1
		run_compose \
			--profile asset-sync \
			run --rm \
			-e HOUKAGO_ASSET_PUBLICATION_ACTION=stage \
			-e HOUKAGO_ASSET_PUBLICATION_GENERATION_ID="$checkout_head" \
			asset-sync
	) 2>&1 | tee "$asset_log"
	stage_status=${PIPESTATUS[0]}

	success_line="$(grep -F \
		"phase=ASSET_STAGE_SUCCESS status=SUCCESS generationId=${checkout_head} " \
		"$asset_log" | tail -n 1)"
	if [[ "$stage_status" -ne 0 || -z "$success_line" ]]; then
		rm -f -- "$asset_log"
		return 1
	fi

	ASSET_PUBLIC_POST_COUNT="$(extract_log_field "$success_line" "publicPostCount")"
	ASSET_COUNT="$(extract_log_field "$success_line" "assetCount")"
	ASSET_TOTAL_BYTES="$(extract_log_field "$success_line" "totalBytes")"
	ASSET_SMOKE_PATH="$(extract_log_field "$success_line" "smokeAssetPath")"
	rm -f -- "$asset_log"

	if [[ ! "$ASSET_PUBLIC_POST_COUNT" =~ ^[0-9]+$ \
			|| ! "$ASSET_COUNT" =~ ^[0-9]+$ \
			|| ! "$ASSET_TOTAL_BYTES" =~ ^[0-9]+$ ]]; then
		return 1
	fi
	if [[ "$ASSET_SMOKE_PATH" != "NONE" && "$ASSET_SMOKE_PATH" != /assets/posts/* ]]; then
		return 1
	fi
	if [[ ("$ASSET_COUNT" -eq 0 && "$ASSET_SMOKE_PATH" != "NONE") \
			|| ("$ASSET_COUNT" -gt 0 && "$ASSET_SMOKE_PATH" == "NONE") ]]; then
		return 1
	fi

	log "phase=asset_stage status=SUCCESS service=asset-sync deliveryId=${delivery_id} commitSha=${checkout_head} generation=${checkout_head} publicPostCount=${ASSET_PUBLIC_POST_COUNT} assetCount=${ASSET_COUNT} totalBytes=${ASSET_TOTAL_BYTES}"
	return 0
}

run_asset_activate() {
	local delivery_id="$1"
	local checkout_head="$2"
	local asset_log activate_status

	asset_log="$(mktemp "${TEMPORARY_DIRECTORY}/asset-activate-${delivery_id}.XXXXXX.log")" || return 1
	log "phase=asset_activate status=STARTED service=asset-sync deliveryId=${delivery_id} commitSha=${checkout_head} generation=${checkout_head}"
	(
		cd "$SERVER_ROOT" || exit 1
		run_compose \
			--profile asset-sync \
			run --rm \
			-e HOUKAGO_ASSET_PUBLICATION_ACTION=activate \
			-e HOUKAGO_ASSET_PUBLICATION_GENERATION_ID="$checkout_head" \
			asset-sync
	) 2>&1 | tee "$asset_log"
	activate_status=${PIPESTATUS[0]}

	if [[ "$activate_status" -ne 0 ]] \
			|| ! grep -Fq \
				"phase=ASSET_ACTIVATE_SUCCESS status=SUCCESS generationId=${checkout_head}" \
				"$asset_log"; then
		rm -f -- "$asset_log"
		return 1
	fi

	rm -f -- "$asset_log"
	log "phase=asset_activate status=SUCCESS service=asset-sync deliveryId=${delivery_id} commitSha=${checkout_head} generation=${checkout_head}"
	return 0
}

verify_public_asset() {
	local delivery_id="$1"
	local checkout_head="$2"
	local current_target headers_file http_status curl_status

	if [[ ! -L "${PUBLIC_ASSET_ROOT}/current" ]]; then
		return 1
	fi
	current_target="$(readlink "${PUBLIC_ASSET_ROOT}/current")" || return 1
	if [[ "$current_target" != "releases/${checkout_head}" ]]; then
		return 1
	fi
	if [[ "$ASSET_SMOKE_PATH" == "NONE" ]]; then
		log "phase=asset_smoke status=SKIPPED deliveryId=${delivery_id} commitSha=${checkout_head} generation=${checkout_head} reason=no_public_assets"
		return 0
	fi
	if [[ "$PUBLIC_ASSET_BASE_URL" != https://* ]]; then
		return 1
	fi

	headers_file="$(mktemp "${TEMPORARY_DIRECTORY}/asset-smoke-${delivery_id}.XXXXXX.headers")" || return 1
	http_status="$(curl \
		--silent \
		--show-error \
		--output /dev/null \
		--dump-header "$headers_file" \
		--write-out '%{http_code}' \
		--proto '=https' \
		--connect-timeout 5 \
		--max-time 15 \
		"${PUBLIC_ASSET_BASE_URL}${ASSET_SMOKE_PATH}" 2>/dev/null)"
	curl_status=$?
	if [[ "$curl_status" -ne 0 || "$http_status" != "200" ]] \
			|| ! grep -Eiq '^ETag:' "$headers_file" \
			|| ! grep -Eiq '^Cache-Control:.*max-age=300' "$headers_file"; then
		rm -f -- "$headers_file"
		return 1
	fi

	rm -f -- "$headers_file"
	log "phase=asset_smoke status=SUCCESS deliveryId=${delivery_id} commitSha=${checkout_head} generation=${checkout_head} assetPath=${ASSET_SMOKE_PATH}"
	return 0
}

process_job() {
	local incoming_path="$1"
	local validation_output delivery_id commit_sha base_name processing_path
	local git_status current_branch origin_main current_head checkout_head readability_output
	local unreadable_path quoted_path

	base_name="$(basename -- "$incoming_path")"
	if [[ ! -f "$incoming_path" || -L "$incoming_path" ]]; then
		mark_failed "$incoming_path" "invalid_job_file" || true
		return 1
	fi
	if ! validation_output="$(validate_job "$incoming_path" 2>/dev/null)"; then
		mark_failed "$incoming_path" "invalid_job" || true
		return 1
	fi
	delivery_id="$(printf '%s\n' "$validation_output" | sed -n '1p')"
	commit_sha="$(printf '%s\n' "$validation_output" | sed -n '2p')"

	for state_directory in "$PROCESSING_DIRECTORY" "$SUCCEEDED_DIRECTORY" "$FAILED_DIRECTORY"; do
		if [[ -e "${state_directory}/${base_name}" ]]; then
			mark_failed "$incoming_path" "duplicate_delivery" || true
			return 1
		fi
	done

	processing_path="${PROCESSING_DIRECTORY}/${base_name}"
	if ! move_without_overwrite "$incoming_path" "$processing_path"; then
		mark_failed "$incoming_path" "processing_move" || true
		return 1
	fi
	current_processing_path="$processing_path"

	if ! git_status="$(git -C "$POSTS_ROOT" status --porcelain --untracked-files=normal)"; then
		mark_failed "$processing_path" "git_status" || true
		return 1
	fi
	if [[ -n "$git_status" ]]; then
		mark_failed "$processing_path" "dirty_checkout" || true
		return 1
	fi
	if ! current_branch="$(git -C "$POSTS_ROOT" branch --show-current)"; then
		mark_failed "$processing_path" "git_branch" || true
		return 1
	fi
	if [[ "$current_branch" != "main" ]]; then
		mark_failed "$processing_path" "unexpected_branch" || true
		return 1
	fi
	if ! run_checkout_git fetch --quiet origin main; then
		mark_failed "$processing_path" "git_fetch" || true
		return 1
	fi
	if ! git_status="$(git -C "$POSTS_ROOT" status --porcelain --untracked-files=normal)"; then
		mark_failed "$processing_path" "git_status_after_fetch" || true
		return 1
	fi
	if [[ -n "$git_status" ]]; then
		mark_failed "$processing_path" "dirty_checkout_after_fetch" || true
		return 1
	fi
	if ! git -C "$POSTS_ROOT" cat-file -e "${commit_sha}^{commit}" 2>/dev/null; then
		mark_failed "$processing_path" "unknown_commit" || true
		return 1
	fi
	origin_main="$(git -C "$POSTS_ROOT" rev-parse refs/remotes/origin/main)" || {
		mark_failed "$processing_path" "missing_origin_main" || true
		return 1
	}
	if ! git -C "$POSTS_ROOT" merge-base --is-ancestor "$commit_sha" "$origin_main"; then
		mark_failed "$processing_path" "job_not_on_origin_main" || true
		return 1
	fi
	current_head="$(git -C "$POSTS_ROOT" rev-parse HEAD)" || {
		mark_failed "$processing_path" "missing_checkout_head" || true
		return 1
	}
	if ! git -C "$POSTS_ROOT" merge-base --is-ancestor "$current_head" "$commit_sha"; then
		mark_failed "$processing_path" "non_fast_forward" || true
		return 1
	fi
	if ! run_checkout_git merge --ff-only --quiet "$commit_sha"; then
		mark_failed "$processing_path" "git_merge" || true
		return 1
	fi
	checkout_head="$(git -C "$POSTS_ROOT" rev-parse HEAD)" || {
		mark_failed "$processing_path" "checkout_verification" || true
		return 1
	}
	if [[ "$checkout_head" != "$commit_sha" ]]; then
		mark_failed "$processing_path" "checkout_commit_mismatch" || true
		return 1
	fi
	if ! readability_output="$(verify_checkout_readable 2>&1)"; then
		unreadable_path="$(printf '%s\n' "$readability_output" \
			| sed -n 's/^HOUKAGO_UNREADABLE_PATH=//p' \
			| tail -n 1)"
		if [[ -n "$unreadable_path" ]]; then
			printf -v quoted_path '%q' "$unreadable_path"
			log "status=FAILED reason=checkout_unreadable path=${quoted_path} job=${base_name}"
		fi
		mark_failed "$processing_path" "checkout_unreadable" || true
		return 1
	fi

	if ! run_asset_stage "$delivery_id" "$checkout_head"; then
		mark_failed "$processing_path" "asset_stage" || true
		return 1
	fi
	if ! run_one_shot_sync "$delivery_id" "$checkout_head"; then
		mark_failed "$processing_path" "one_shot_sync" || true
		return 1
	fi
	if ! run_asset_activate "$delivery_id" "$checkout_head"; then
		mark_failed "$processing_path" "asset_activation" || true
		return 1
	fi
	if ! verify_public_api; then
		mark_failed "$processing_path" "public_api_smoke" || true
		return 1
	fi
	if ! verify_public_asset "$delivery_id" "$checkout_head"; then
		mark_failed "$processing_path" "public_asset_smoke" || true
		return 1
	fi
	if ! revalidate_frontend; then
		log "phase=frontend_revalidation status=WARNING backendSync=SUCCESS assetPublication=SUCCESS reason=non_fatal"
	fi
	if ! move_without_overwrite "$processing_path" "${SUCCEEDED_DIRECTORY}/${base_name}"; then
		mark_failed "$processing_path" "succeeded_move" || true
		return 1
	fi
	current_processing_path=""

	log "status=SUCCESS deliveryId=${delivery_id} commitSha=${checkout_head}"
	return 0
}

retry_failed_job() {
	local delivery_id="$1"
	local failed_path incoming_path validation_output validated_delivery_id
	local timestamp history_path

	if [[ ! "$delivery_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
		log "status=FAILED reason=retry_invalid_delivery_id"
		return 1
	fi
	failed_path="${FAILED_DIRECTORY}/${delivery_id}.json"
	incoming_path="${INCOMING_DIRECTORY}/${delivery_id}.json"
	if [[ ! -f "$failed_path" || -L "$failed_path" ]]; then
		log "status=FAILED reason=retry_job_not_found deliveryId=${delivery_id}"
		return 1
	fi
	if ! validation_output="$(validate_job "$failed_path" 2>/dev/null)"; then
		log "status=FAILED reason=retry_invalid_job deliveryId=${delivery_id}"
		return 1
	fi
	validated_delivery_id="$(printf '%s\n' "$validation_output" | sed -n '1p')"
	if [[ "$validated_delivery_id" != "$delivery_id" ]]; then
		log "status=FAILED reason=retry_delivery_mismatch deliveryId=${delivery_id}"
		return 1
	fi
	for state_directory in "$INCOMING_DIRECTORY" "$PROCESSING_DIRECTORY" "$SUCCEEDED_DIRECTORY"; do
		if [[ -e "${state_directory}/${delivery_id}.json" ]]; then
			log "status=FAILED reason=retry_active_delivery deliveryId=${delivery_id}"
			return 1
		fi
	done

	timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
	history_path="${FAILED_DIRECTORY}/${delivery_id}.operator-retry-${timestamp}-$$.json"
	if ! cp -- "$failed_path" "$history_path"; then
		log "status=FAILED reason=retry_history_copy deliveryId=${delivery_id}"
		return 1
	fi
	chmod 0640 "$history_path" || {
		rm -f -- "$history_path"
		log "status=FAILED reason=retry_history_permission deliveryId=${delivery_id}"
		return 1
	}
	if ! move_without_overwrite "$failed_path" "$incoming_path"; then
		rm -f -- "$history_path"
		log "status=FAILED reason=retry_enqueue deliveryId=${delivery_id}"
		return 1
	fi

	log "status=REQUEUED reason=operator_retry deliveryId=${delivery_id} history=$(basename -- "$history_path")"
	return 0
}

main() {
	local job_path

	for directory in "$INCOMING_DIRECTORY" "$PROCESSING_DIRECTORY" "$SUCCEEDED_DIRECTORY" \
			"$FAILED_DIRECTORY" "$TEMPORARY_DIRECTORY"; do
		[[ -d "$directory" ]] || {
			log "status=FAILED reason=missing_directory"
			return 1
		}
	done

	exec 9>"$LOCK_FILE" || {
		log "status=FAILED reason=lock_open"
		return 1
	}
	if ! flock -n 9; then
		log "status=QUEUED reason=content_lock_busy"
		return 0
	fi
	exec 8>"$MAINTENANCE_LOCK_FILE" || {
		log "status=FAILED reason=maintenance_lock_open"
		return 1
	}
	if ! flock -w "$MAINTENANCE_LOCK_TIMEOUT_SECONDS" 8; then
		log "status=QUEUED reason=maintenance_lock_busy timeoutSeconds=${MAINTENANCE_LOCK_TIMEOUT_SECONDS}"
		return 0
	fi

	recover_orphaned_jobs

	while true; do
		shopt -s nullglob
		set -- "${INCOMING_DIRECTORY}"/*.json
		shopt -u nullglob
		[[ $# -gt 0 ]] || break

		for job_path in "$@"; do
			if ! process_job "$job_path"; then
				failures=$((failures + 1))
			fi
		done
	done

	log "status=COMPLETE failures=${failures}"
	[[ "$failures" -eq 0 ]]
}

dispatch() {
	if [[ $# -eq 0 ]]; then
		main
		return
	fi

	case "$1" in
		revalidate)
			if [[ $# -ne 1 ]]; then
				printf 'usage: %s revalidate\n' "$0" >&2
				return 2
			fi
			revalidate_frontend
			;;
		retry)
			if [[ $# -ne 2 ]]; then
				printf 'usage: %s retry <failed-delivery-id>\n' "$0" >&2
				return 2
			fi
			retry_failed_job "$2"
			;;
		*)
			printf 'usage: %s [revalidate | retry <failed-delivery-id>]\n' "$0" >&2
			return 2
			;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	trap cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	trap 'exit 129' HUP
	dispatch "$@"
fi

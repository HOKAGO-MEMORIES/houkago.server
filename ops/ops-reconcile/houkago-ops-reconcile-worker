SHA_PATTERN = re.compile(r"[0-9a-f]{40}")
IMAGE_PATTERN = re.compile(r"[^\s=]+@sha256:[0-9a-f]{64}")
JOB_FIELDS = {"deliveryId", "revision", "receivedAt", "notBefore"}
STATE_FIELDS = {"version", "revision", "recordedAt", "managedFiles"}
CLASSIFIER_SOURCE = "ops/ci/classify_backend_changes.py"


class ReconcileError(RuntimeError):
    def __init__(self, reason: str):
        super().__init__(reason)
        self.reason = reason


class WorkerInterrupted(ReconcileError):
    pass


@dataclass(frozen=True)
class ManagedFile:
    source: str
    target: Path
    mode: int
    kind: str


